# Copy to .env. Loaded into both containers via env_file.
# Real values belong in .env, which is gitignored. Never commit a secret here.

# ============================================================================
# SHARED
# ============================================================================
# Shared secret, used by ALL THREE containers:
#   backend - validates the X-API-Key header
#   voice   - sends it on its own calls
#   ui      - nginx injects it into proxied requests, so the browser never
#             holds it
# Generate one with:
#   openssl rand -base64 32
API_KEY=change-me-to-a-strong-secret

# ============================================================================
# DASHBOARD
# ============================================================================
# Where nginx forwards /api/*. Host networking puts the backend on loopback.
#BACKEND_ORIGIN=http://127.0.0.1:8000
#
# The dashboard serves on http://127.0.0.1:8080 — point Chromium kiosk there.
# See docs/UI.md for the i3 kiosk invocation.

# ============================================================================
# VOICE PIPELINE
# ============================================================================
# Host `audio` group id, needed at BUILD time for /dev/snd access.
# Check with: getent group audio
AUDIO_GID=29

# Audio devices. A name substring is more robust than an index, because
# indexes get reordered by reboots and replugs. List them with:
#   docker compose exec voice python -m voice_assistant.devices
#
# Pick a substring that matches ONE device of that direction. Candidates are
# already filtered by direction, so a bare "USB" is fine when your mic is
# capture-only and your speaker is playback-only. It becomes ambiguous as soon
# as one device does both -- a USB headset, for instance -- and then the
# pipeline takes whichever enumerates first. It logs a warning whenever a spec
# matches more than one device; if you see that warning, narrow the substring.
# Being specific costs nothing. For a USB PnP mic and a separate USB speaker:
VOICE_INPUT_DEVICE=USB PnP
VOICE_OUTPUT_DEVICE=USB2.0

# Backend API. Host networking puts both containers on the host's loopback.
VOICE_API_BASE_URL=http://127.0.0.1:8000

# ============================================================================
# SERVICE HEALTH
# ============================================================================
# The pipeline proves it is alive by POSTing /voice/heartbeat on a timer; the
# backend marks it down when the check-ins stop. Keep the stale window a
# comfortable multiple of the send interval — 45/15 tolerates two dropped
# beats before the status flaps.
#VOICE_HEARTBEAT_INTERVAL_S=15     # sender, voice container
#SERVICE_STALE_AFTER_S=45          # receiver, backend container

# --- Tuning (all optional; defaults shown) ---------------------------------
# Wake word. Lower WW_THRESHOLD to trigger more easily at the cost of more
# false positives.
#VOICE_WAKE_WORD=hey_jarvis
#VOICE_WW_THRESHOLD=0.5
#VOICE_VAD_THRESHOLD=0.5

# Recording envelope, milliseconds.
#VOICE_PRE_ROLL_MS=500
#VOICE_SILENCE_TIMEOUT_MS=800
#VOICE_MAX_RECORDING_MS=8000

# Models. Defaults resolve under /app/models (the read-only bind mount).
# Swap to qwen2.5-0.5b-instruct-q4_k_m.gguf to trade accuracy for ~3x speed.
#VOICE_SLM_MODEL=models/qwen2.5-1.5b-instruct-q5_k_m.gguf
#VOICE_WHISPER_SIZE=tiny.en

# Regex pre-classifier. Skips the SLM on common phrasings, which matters a lot
# with the 1.5B model. Disable only to measure classifier accuracy.
#VOICE_FASTPATH=true

# Set false to skip loading the SLM entirely: saves ~1.2 GB RSS, and anything
# the fast path does not match becomes "unknown".
#VOICE_SLM_ENABLED=true

# DEBUG-level logs with per-stage timings.
#VOICE_VERBOSE=false
