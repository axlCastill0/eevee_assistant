# Copy to .env. Loaded into both containers via env_file.
# Real values belong in .env, which is gitignored. Never commit a secret here.

# ============================================================================
# SHARED
# ============================================================================
# Shared secret, used by ALL THREE containers:
#   backend - validates the X-API-Key header
#   voice   - sends it on its own calls
#   ui      - nginx injects it into proxied requests, so the browser never
#             holds it
# Generate one with:
#   openssl rand -base64 32
API_KEY=change-me-to-a-strong-secret

# ============================================================================
# DASHBOARD
# ============================================================================
# Where nginx forwards /api/*. Host networking puts the backend on loopback.
#BACKEND_ORIGIN=http://127.0.0.1:8000
#
# The dashboard serves on http://127.0.0.1:8080 — point Chromium kiosk there.
# See docs/UI.md for the i3 kiosk invocation.

# ============================================================================
# VOICE PIPELINE
# ============================================================================
# Host `audio` group id, needed at BUILD time for /dev/snd access.
# Check with: getent group audio
AUDIO_GID=29

# Audio devices. A name substring is more robust than an index, because
# indexes get reordered by reboots and replugs. List them with:
#   docker compose exec voice python -m voice_assistant.devices
#
# Pick a substring that matches ONE device of that direction. Candidates are
# already filtered by direction, so a bare "USB" is fine when your mic is
# capture-only and your speaker is playback-only. It becomes ambiguous as soon
# as one device does both -- a USB headset, for instance -- and then the
# pipeline takes whichever enumerates first. It logs a warning whenever a spec
# matches more than one device; if you see that warning, narrow the substring.
# Being specific costs nothing. For a USB PnP mic and a separate USB speaker:
VOICE_INPUT_DEVICE=USB PnP
VOICE_OUTPUT_DEVICE=USB2.0
#
# For hardware that stays plugged in, pin each card's ALSA *id* with a udev
# rule and address it as CARD=<id>. It cannot go ambiguous and it survives
# replugs. See "Lock the devices in place" in docs/README_PI.md.
#
# The CARD= prefix is required: udev renames the card id, NOT the device name
# PortAudio reports, so a bare `eeveemic` matches nothing. The id is resolved
# through libasound over /dev/snd -- /proc/asound is masked to an empty
# directory inside a container, so it cannot be read there.
#VOICE_INPUT_DEVICE=CARD=eeveemic
#VOICE_OUTPUT_DEVICE=CARD=eeveespk

# Backend API. Host networking puts both containers on the host's loopback.
VOICE_API_BASE_URL=http://127.0.0.1:8000

# ============================================================================
# SPOTIFY  (the Music view)
# ============================================================================
# From https://developer.spotify.com/dashboard. The secret stays on the
# backend and never reaches the browser.
#
# Reading what is playing works on a free account; the play/pause/skip
# controls need Premium, and all of them need an ACTIVE DEVICE -- the Web API
# is a remote control and cannot start audio on its own. Full setup, including
# how to complete the one-time consent screen on a headless Pi, is in
# docs/SPOTIFY.md.
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=

# Must match the redirect URI registered in the Spotify dashboard EXACTLY.
# Spotify no longer accepts `localhost`; it has to be the loopback IP.
#SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback

# Where the refresh token is written. Inside the container this is the
# ../../state bind mount, so authorization survives a restart. Keep it on a
# writable volume or you will re-authorize on every boot.
#SPOTIFY_TOKEN_PATH=/app/state/spotify.json

# ============================================================================
# TIMERS, ALARMS AND SOUNDS
# ============================================================================
# Sounds are files in ./media at the repo root, bind-mounted read-only at
# /app/media. Drop .mp3 (or .wav/.ogg/.m4a/.flac) in there and pick them on
# the dashboard's Settings page -- no rebuild, no restart.
#MEDIA_DIR=/app/media
#
# Alarms and settings persist in the writable state volume, next to the
# Spotify token. Timers deliberately do NOT persist: a countdown only means
# anything relative to now.
#ALARMS_PATH=/app/state/alarms.json
#SETTINGS_PATH=/app/state/settings.json

# ============================================================================
# SCREEN
# ============================================================================
# There is nothing to set here, but two things are worth knowing:
#
#   - the idle blank (30 minutes by default) is a SETTING, not an env var --
#     change it on the dashboard's Settings page
#   - the backlight is switched by scripts/screen-agent.sh, which runs on the
#     HOST inside the kiosk session, not in any container. Without it the
#     panel blacks out but stays lit. See "The screen agent" in
#     docs/README_PI.md

# ============================================================================
# SERVICE HEALTH
# ============================================================================
# The pipeline proves it is alive by POSTing /voice/heartbeat on a timer; the
# backend marks it down when the check-ins stop. Keep the stale window a
# comfortable multiple of the send interval — 45/15 tolerates two dropped
# beats before the status flaps.
#VOICE_HEARTBEAT_INTERVAL_S=15     # sender, voice container
#SERVICE_STALE_AFTER_S=45          # receiver, backend container

# ============================================================================
# VOICE ACTIVITY (the dashboard's voice pill)
# ============================================================================
# The pipeline POSTs every stage transition (ready/listening/thinking/speaking)
# to /voice/state, and the dashboard receives them over a WebSocket. This is
# what turns the pill green the moment the wake word fires. Posted from a
# background thread and never waited on, so a dead backend costs a stale pill,
# not latency. Set to false to stop publishing; the pill then reads "unknown".
#VOICE_STATE_EVENTS=true
#VOICE_STATE_EVENT_TIMEOUT_S=1.0   # short on purpose: a late event is useless

# --- Tuning (all optional; defaults shown) ---------------------------------
# Wake word. The default is "hey_jarvis", baked into the image -- no files
# needed. The "hey eevee" heed model is still supported (it fired on room
# noise on this Pi, which is why it is not the default any more):
#   ./scripts/install-wake-model.sh   then   VOICE_WAKE_WORD=models/hey_eevee.onnx
#VOICE_WAKE_WORD=hey_jarvis
#
# Threshold. Unset means "whatever the model was calibrated at" -- 0.5 for
# openWakeWord, 0.603 from the sidecar for hey eevee. A value tuned for one
# model is meaningless for the other: 0.9 tightens the heed model and leaves
# hey_jarvis deaf. CLEAR THIS when switching models.
#VOICE_WW_THRESHOLD=0.5
#
# Feature-extraction conventions the heed sidecar does not pin down. Only touch
# these if a known-good clip scores low in `python -m voice_assistant.wake_check`
# -- see section 13 of docs/VOICE_SETUP.md.
#VOICE_WW_MEL_SCALE=htk      # htk | slaney
#VOICE_WW_MEL_NORM=none      # none | slaney
#VOICE_WW_LOG_BASE=e         # e | 10
#VOICE_WW_NOTCH_Q=30
#VOICE_VAD_THRESHOLD=0.5
#VOICE_VAD_THRESHOLD=0.5

# Recording envelope, milliseconds.
#VOICE_PRE_ROLL_MS=500
#VOICE_SILENCE_TIMEOUT_MS=800
#VOICE_MAX_RECORDING_MS=8000

# Models. Defaults resolve under /app/models (the read-only bind mount).
# Swap to qwen2.5-0.5b-instruct-q4_k_m.gguf to trade accuracy for ~3x speed.
#VOICE_SLM_MODEL=models/qwen2.5-1.5b-instruct-q5_k_m.gguf
#VOICE_WHISPER_SIZE=tiny.en

# Regex pre-classifier. Skips the SLM on common phrasings, which matters a lot
# with the 1.5B model. Disable only to measure classifier accuracy.
#VOICE_FASTPATH=true

# Set false to skip loading the SLM entirely: saves ~1.2 GB RSS, and anything
# the fast path does not match becomes "unknown".
#VOICE_SLM_ENABLED=true

# DEBUG-level logs with per-stage timings.
#VOICE_VERBOSE=false

# ============================================================================
# WEATHER
# ============================================================================
# Open-Meteo: no account, no API key, no signup. Without a location set, the
# get_weather intent says so out loud rather than guessing.
# Find your coordinates at https://www.latlong.net (3 decimal places is plenty
# — more than that is just telling a public API which room you are in).
#WEATHER_LAT=43.651
#WEATHER_LON=-79.383
#WEATHER_PLACE=Toronto              # spoken aloud; leave empty to omit the place
#WEATHER_UNITS=celsius              # or fahrenheit
