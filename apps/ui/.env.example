# Local development only (`npm run dev`). In Docker, nginx injects the API key
# and these are unused.
#
# These are read by vite.config.ts in the DEV SERVER process, not compiled into
# the bundle — the key never reaches the browser. Do not rename them to
# VITE_-prefixed values that get inlined at build time.
VITE_DEV_API_URL=http://127.0.0.1:8000
VITE_DEV_API_KEY=change-me-to-match-your-backend
