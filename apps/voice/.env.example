# Copy to .env for running the pipeline OUTSIDE Docker (bare metal on the Pi).
# In Docker, infra/docker/.env is used instead.
#
# Running bare metal needs Python 3.11 and the models in ./models relative to
# the working directory. See docs/VOICE_SETUP.md.

API_KEY=change-me-to-a-strong-secret
VOICE_API_BASE_URL=http://127.0.0.1:8000

VOICE_INPUT_DEVICE=0
VOICE_OUTPUT_DEVICE=1

VOICE_MODEL_DIR=models
VOICE_VERBOSE=true
