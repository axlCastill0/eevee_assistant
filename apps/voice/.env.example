# Copy to .env for running the pipeline OUTSIDE Docker (bare metal on the Pi).
# In Docker, infra/docker/.env is used instead.
#
# Running bare metal needs a Python 3.11 interpreter and the models in ./models
# relative to the working directory. Note that Raspberry Pi OS Trixie ships
# Python 3.13, so 3.11 has to come from pyenv/uv or similar -- which is a good
# reason to just use Docker. See docs/VOICE_SETUP.md.

API_KEY=change-me-to-a-strong-secret
VOICE_API_BASE_URL=http://127.0.0.1:8000

VOICE_INPUT_DEVICE=0
VOICE_OUTPUT_DEVICE=1

VOICE_MODEL_DIR=models
VOICE_VERBOSE=true

# ============================================================================
# VOICE ACTIVITY (the dashboard's voice pill)
# ============================================================================
# The pipeline POSTs every stage transition (ready/listening/thinking/speaking)
# to /voice/state, and the dashboard receives them over a WebSocket. This is
# what turns the pill green the moment the wake word fires. Posted from a
# background thread and never waited on, so a dead backend costs a stale pill,
# not latency. Set to false to stop publishing; the pill then reads "unknown".
#VOICE_STATE_EVENTS=true
#VOICE_STATE_EVENT_TIMEOUT_S=1.0   # short on purpose: a late event is useless

# ============================================================================
# RESPONSE PHRASING (the assistant's voice)
# ============================================================================
# The backend decides what is true and composes a canonical sentence. The SLM
# can re-word it so the assistant does not say the same thing the same way
# forever. Any rewrite that drops a required fact, names a healthy service, or
# fails to sound like bad news when the news is bad is discarded and the
# canonical sentence is spoken instead.
#
#   off   never phrase (the behaviour before 2026-10-08)
#   slow  phrase only answers the SLM already classified; fast-path hits stay
#         instant and canned. DEFAULT.
#   all   phrase everything. Adds roughly 2-4s to a fast-path hit.
#VOICE_PHRASE_SCOPE=slow
#VOICE_PHRASE_TEMPERATURE=0.8      # variation is the point; NOT the classifier's 0.0
#VOICE_PHRASE_MAX_TOKENS=48        # one short spoken sentence
#VOICE_PERSONA_ADDRESS=sir         # used about one reply in three; empty disables
