# Copy to .env and set a strong secret. Sent by clients as the X-API-Key header.
API_KEY=change-me-to-a-strong-secret

# ============================================================================
# WEATHER
# ============================================================================
# Open-Meteo: no account, no API key, no signup. Without a location set, the
# get_weather intent says so out loud rather than guessing.
# Find your coordinates at https://www.latlong.net (3 decimal places is plenty
# — more than that is just telling a public API which room you are in).
#WEATHER_LAT=43.651
#WEATHER_LON=-79.383
#WEATHER_PLACE=Toronto              # spoken aloud; leave empty to omit the place
#WEATHER_UNITS=celsius              # or fahrenheit
