# Copy to .env and set a strong secret. Sent by clients as the X-API-Key header.
API_KEY=change-me-to-a-strong-secret

# ============================================================================
# WEATHER
# ============================================================================
# Open-Meteo: no account, no API key, no signup. Without a location set, the
# get_weather intent says so out loud rather than guessing.
# Find your coordinates at https://www.latlong.net (3 decimal places is plenty
# — more than that is just telling a public API which room you are in).
#WEATHER_LAT=43.651
#WEATHER_LON=-79.383
#WEATHER_PLACE=Toronto              # spoken aloud; leave empty to omit the place
#WEATHER_UNITS=celsius              # or fahrenheit

# ============================================================================
# WAKE ON LAN (optional -- the dashboard's "Home" app, and "wake the computer")
# ============================================================================
# One machine. The PC must have Wake-on-LAN enabled in its firmware AND in
# Windows (Device Manager -> network adapter -> Power Management -> "Allow
# this device to wake the computer"). Fast Startup can stop a shut-down PC
# waking; sleep/hibernate are reliable.
#
# This only works because the backend runs with network_mode: host -- a
# bridged container's broadcast never leaves docker0. See wol.py.
#WOL_MAC=AA:BB:CC:DD:EE:FF
#WOL_NAME=the PC                    # said out loud; default "the computer"
#WOL_BROADCAST=255.255.255.255      # try 192.168.0.255 if your net drops this
#WOL_PORT=9
# Optional: lets the panel show whether it actually came up. Without it the
# app says "status unknown" rather than guessing.
#WOL_HOST=192.168.0.50
#WOL_PROBE_PORT=3389                # Windows RDP. 445 or 22 work too

# ============================================================================
# SPOTIFY (optional -- the dashboard's Music view)
# ============================================================================
# See docs/SPOTIFY.md. Reading playback works on a free account; controlling
# it needs Premium and an already-active device.
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=
#SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback
# Bare-metal runs have no /app/state; point this somewhere writable.
#SPOTIFY_TOKEN_PATH=./state/spotify.json
